# Copied to .env by `make infra-up` when .env is missing. Development defaults only.

COMPOSE_PROJECT_NAME=ngumbah
GITHUB_OWNER=tahananazkaban

# Host ports
FLOCI_PORT=4566
POSTGRES_PORT=5432
VALKEY_PORT=6379
TENANT_SVC_PORT=50051
GATEWAY_PORT=8080

# Postgres superuser (infra only, never used by services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# One database + login role per service: <name>_db owned by <name>_svc
NGUMBAH_SERVICES="tenant customer pricing order delivery"
TENANT_SVC_DB_PASSWORD=tenant_svc_dev
CUSTOMER_SVC_DB_PASSWORD=customer_svc_dev
PRICING_SVC_DB_PASSWORD=pricing_svc_dev
ORDER_SVC_DB_PASSWORD=order_svc_dev
DELIVERY_SVC_DB_PASSWORD=delivery_svc_dev

# AWS CLI / SDKs pointed at Floci (any non-empty credentials work)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
